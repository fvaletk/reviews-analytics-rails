# Database — used by the Rails app to connect to PostgreSQL
DATABASE_URL=postgres://your_db_user:your_db_password@db:5432/reviews_analytics_development

# Redis — used by ActionCable and Sidekiq
REDIS_URL=redis://redis:6379/1

# Rails master key — used to decrypt credentials
RAILS_MASTER_KEY=your_master_key_here

# PostgreSQL container credentials — used by the db service in docker-compose.yml
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=reviews_analytics_development

# Google OAuth2 — used by OmniAuth for authentication
GOOGLE_OAUTH_CLIENT_ID=your_google_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_google_client_secret

# FastAPI scraping microservice — used by ScrapingService
SCRAPING_SERVICE_URL=http://scraping:8000

GEMINI_API_KEY=your_gemini_key
