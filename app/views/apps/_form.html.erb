<% if @app.errors.any? %>
  <div class="form-error-banner">
    <ul>
      <% @app.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<div class="card">
  <%= form_with model: [@workspace, @app] do |f| %>
    <div class="form-field">
      <%= f.label :name, "App Name", class: "form-label" %>
      <%= f.text_field :name,
            placeholder: "e.g. Spotify, Notion, My App...",
            class: "form-input" %>
    </div>

    <div class="form-field mt-6">
      <%= f.label :app_store_url, "App Store URL", class: "form-label" %>
      <%= f.text_field :app_store_url,
            placeholder: "https://apps.apple.com/us/app/app-name/id123456789",
            class: "form-input" %>
      <p class="form-hint">Optional. The store ID is parsed automatically from the URL.</p>
    </div>

    <div class="form-field mt-6">
      <%= f.label :play_store_url, "Play Store URL", class: "form-label" %>
      <%= f.text_field :play_store_url,
            placeholder: "https://play.google.com/store/apps/details?id=com.example.app",
            class: "form-input" %>
      <p class="form-hint">Optional. The store ID is parsed automatically from the URL.</p>
    </div>

    <div class="form-actions">
      <% if @app.persisted? %>
        <%= link_to "Cancel", workspace_app_path(@workspace, @app), class: "btn-ghost" %>
        <%= f.submit "Save Changes", class: "btn-primary" %>
      <% else %>
        <%= link_to "Cancel", workspace_path(@workspace), class: "btn-ghost" %>
        <%= f.submit "Add App", class: "btn-primary" %>
      <% end %>
    </div>
  <% end %>
</div>
