<% content_for :title, "#{@app.name} — #{@workspace.name} — Reviews Analytics" %>

<main class="page-container">
  <div class="app-show">
    <%= link_to "← #{@workspace.name}", workspace_path(@workspace), class: "app-show__breadcrumb" %>

    <div class="app-show__header">
      <div class="app-show__icon"><%= @app.name.first %></div>
      <div class="app-show__identity">
        <h1 class="app-show__name"><%= @app.name %></h1>
        <div class="app-show__meta">
          <% if @app.app_store_id.present? %>
            <span class="workspace-app-store-tag">App Store</span>
          <% end %>
          <% if @app.play_store_id.present? %>
            <span class="workspace-app-store-tag">Play Store</span>
          <% end %>
          <span class="app-show__meta-date">Added <%= @app.created_at.strftime("%-d %b %Y") %></span>
        </div>
      </div>
      <%= link_to "View Report History →", workspace_app_reports_path(@workspace, @app), class: "btn-secondary" %>
    </div>

    <hr class="app-show__divider">

    <div class="app-show__body">
      <div class="app-show__details">
        <h2 class="app-show__section-title">Store Details</h2>
        <dl class="store-detail-grid">
          <% if @app.app_store_id.present? %>
            <div class="store-detail-row">
              <dt class="store-detail-label">App Store URL</dt>
              <dd class="store-detail-value">
                <%= link_to "https://apps.apple.com/#{@app.app_store_country}/app/id#{@app.app_store_id}",
                      "https://apps.apple.com/#{@app.app_store_country}/app/id#{@app.app_store_id}",
                      target: "_blank",
                      rel: "noopener noreferrer",
                      class: "store-detail-link" %>
              </dd>
            </div>
          <% end %>

          <% if @app.play_store_id.present? %>
            <div class="store-detail-row">
              <dt class="store-detail-label">Play Store URL</dt>
              <dd class="store-detail-value">
                <%= link_to "https://play.google.com/store/apps/details?id=#{@app.play_store_id}",
                      "https://play.google.com/store/apps/details?id=#{@app.play_store_id}",
                      target: "_blank",
                      rel: "noopener noreferrer",
                      class: "store-detail-link" %>
              </dd>
            </div>
          <% end %>

          <div class="store-detail-row">
            <dt class="store-detail-label">Created by</dt>
            <dd class="store-detail-value"><%= @app.created_by.name.presence || @app.created_by.email %></dd>
          </div>

          <div class="store-detail-row">
            <dt class="store-detail-label">Created</dt>
            <dd class="store-detail-value"><%= @app.created_at.strftime("%-d %b %Y") %></dd>
          </div>

          <div class="store-detail-row">
            <dt class="store-detail-label">Last report</dt>
            <dd class="store-detail-value">
              <% if @latest_report.present? %>
                <%= @latest_report.created_at.strftime("%-d %b %Y") %>
              <% else %>
                No reports yet
              <% end %>
            </dd>
          </div>
        </dl>
      </div>

      <div class="action-rail">
        <div class="action-rail__heading">Generate analysis</div>
        <p class="action-rail__subtext">Build a fresh report from the latest reviews.</p>

        <% if policy(@app).generate_report? %>
          <%= button_to "Generate Report",
                workspace_app_reports_path(@workspace, @app),
                method: :post,
                class: "btn-primary action-rail__primary" %>
        <% end %>

        <div class="action-rail__divider">
          <span class="action-rail__divider-label">Already have reviews?</span>
        </div>

        <div class="action-rail__secondary-group">
          <button class="action-rail__secondary-btn" disabled>Re-analyze existing reviews</button>
          <button class="action-rail__secondary-btn" disabled>Refresh reviews + re-analyze</button>
        </div>
      </div>
    </div>
  </div>
</main>
