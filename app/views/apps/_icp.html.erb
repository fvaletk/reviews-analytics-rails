<%
  generating = local_assigns.fetch(:generating, false)
  no_reviews = @app.reviews.empty?
%>
<div id="app_icp" class="app-show__section">
  <h2 class="app-show__section-title">Ideal Customer Profile</h2>

  <% if @app.icp_extracted? %>
    <div class="icp-result">
      <div class="icp-result__header">
        <h3 class="icp-result__segment"><%= @app.icp["primary_segment"] %></h3>
        <span class="badge icp-confidence"><%= @app.icp["confidence"] %> confidence</span>
      </div>

      <div class="icp-signal-groups">
        <% icp_signal_groups(@app).each do |role_hint, signals| %>
          <div class="icp-signal-group">
            <div class="icp-signal-group__heading">
              <%= role_hint %> · <%= pluralize(signals.size, "supporting quote") %>
            </div>
            <ul class="icp-signal-group__quotes">
              <% signals.each do |signal| %>
                <li class="icp-signal-group__quote">&ldquo;<%= signal["quote"] %>&rdquo;</li>
              <% end %>
            </ul>
          </div>
        <% end %>
      </div>
    </div>
  <% elsif @app.icp_extraction_attempted? %>
    <p class="icp-declined"><%= @app.icp_declined_reason %></p>
  <% else %>
    <div class="icp-empty-state">
      <p class="icp-empty-state__copy">No ideal customer profile has been generated for this app yet.</p>
    </div>
  <% end %>

  <% if policy(@app).generate_report? %>
    <div class="icp-actions">
      <% if @app.icp_extraction_attempted? %>
        <%= button_to (generating ? "Generating…" : "Regenerate"),
              workspace_app_icp_path(@workspace, @app),
              method: :post,
              class: "action-rail__secondary-btn",
              disabled: generating,
              data: { turbo_confirm: "Regenerate the ideal customer profile? This will overwrite the current result." } %>
      <% else %>
        <%= button_to (generating ? "Generating…" : "Generate ICP"),
              workspace_app_icp_path(@workspace, @app),
              method: :post,
              class: "btn-primary",
              disabled: generating || no_reviews,
              title: (no_reviews ? "Fetch reviews for this app before generating an ICP" : nil) %>
      <% end %>
    </div>
  <% end %>
</div>
