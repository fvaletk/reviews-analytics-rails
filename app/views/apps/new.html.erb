<% content_for :title, "Add App — #{@workspace.name} — Reviews Analytics" %>

<main class="page-container">
  <header class="page-header">
    <h1 class="page-title">Add App</h1>
    <p class="app-form-subheading">Workspace: <strong><%= @workspace.name %></strong></p>
  </header>

  <div class="page-body">
    <div class="card app-form-card">

      <% if @app.errors.any? %>
        <div class="form-error-banner">
          <ul>
            <% @app.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= form_with model: [@workspace, @app], url: workspace_apps_path(@workspace), method: :post do |f| %>

        <div class="form-field">
          <%= f.label :name, "App Name",
                class: "block text-sm font-medium leading-6 text-white" %>
          <div class="mt-2">
            <%= f.text_field :name,
                  placeholder: "e.g. Spotify, Notion, My App...",
                  class: ["block w-full rounded-md border-0 py-2 px-3 bg-white/5 ring-1 ring-inset ring-white/10 text-white placeholder:text-gray-500 focus:ring-2 focus:ring-inset focus:ring-amber-500 sm:text-sm sm:leading-6", ("form-field-error" if @app.errors[:name].any?)].compact.join(" "),
                  autofocus: true %>
          </div>
          <% if @app.errors[:name].any? %>
            <p class="field-error-message"><%= @app.errors[:name].first %></p>
          <% end %>
        </div>

        <div class="form-field">
          <%= label_tag "app_app_store_url", "App Store URL",
                class: "block text-sm font-medium leading-6 text-white mt-6" %>
          <div class="mt-2">
            <%= text_field_tag "app[app_store_url]",
                  params.dig(:app, :app_store_url),
                  placeholder: "https://apps.apple.com/us/app/app-name/id123456789",
                  class: ["block w-full rounded-md border-0 py-2 px-3 bg-white/5 ring-1 ring-inset ring-white/10 text-white placeholder:text-gray-500 focus:ring-2 focus:ring-inset focus:ring-amber-500 sm:text-sm sm:leading-6", ("field-error-input" if @app.errors[:app_store_url].any?)].compact.join(" ") %>
          </div>
          <p class="app-form-hint">Optional. The store ID is parsed automatically from the URL.</p>
          <% if @app.errors[:app_store_url].any? %>
            <p class="field-error-message"><%= @app.errors[:app_store_url].first %></p>
          <% end %>
        </div>

        <div class="form-field">
          <%= label_tag "app_play_store_url", "Play Store URL",
                class: "block text-sm font-medium leading-6 text-white mt-6" %>
          <div class="mt-2">
            <%= text_field_tag "app[play_store_url]",
                  params.dig(:app, :play_store_url),
                  placeholder: "https://play.google.com/store/apps/details?id=com.example.app",
                  class: ["block w-full rounded-md border-0 py-2 px-3 bg-white/5 ring-1 ring-inset ring-white/10 text-white placeholder:text-gray-500 focus:ring-2 focus:ring-inset focus:ring-amber-500 sm:text-sm sm:leading-6", ("field-error-input" if @app.errors[:play_store_url].any?)].compact.join(" ") %>
          </div>
          <p class="app-form-hint">Optional. The store ID is parsed automatically from the URL.</p>
          <% if @app.errors[:play_store_url].any? %>
            <p class="field-error-message"><%= @app.errors[:play_store_url].first %></p>
          <% end %>
        </div>

        <div class="form-actions">
          <%= link_to "CANCEL", workspace_path(@workspace), class: "btn-ghost" %>
          <%= f.submit "ADD APP", class: "btn-primary" %>
        </div>

      <% end %>
    </div>
  </div>
</main>
