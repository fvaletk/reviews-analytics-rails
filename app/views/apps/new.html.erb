<% content_for :title, "Add App — #{@workspace.name} — Reviews Analytics" %>

<main class="page-container">
  <header class="page-header">
    <h1 class="page-title">Add App</h1>
    <p class="app-form-subheading">Workspace: <strong><%= @workspace.name %></strong></p>
  </header>

  <div class="page-body">
    <div class="card app-form-card">

      <% if @app.errors.any? %>
        <div class="form-error-banner">
          <ul>
            <% @app.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= form_with model: [@workspace, @app], url: workspace_apps_path(@workspace), method: :post do |f| %>

        <div class="form-field">
          <%= f.label :name, "App Name", class: "form-label" %>
          <%= f.text_field :name,
                placeholder: "e.g. My App",
                class: ["input", ("form-field-error" if @app.errors[:name].any?)].compact.join(" "),
                autofocus: true %>
          <% if @app.errors[:name].any? %>
            <p class="field-error-message"><%= @app.errors[:name].first %></p>
          <% end %>
        </div>

        <div class="form-field">
          <%= label_tag "app_app_store_url", "App Store URL", class: "form-label" %>
          <%= text_field_tag "app[app_store_url]",
                params.dig(:app, :app_store_url),
                placeholder: "https://apps.apple.com/us/app/my-app/id123456789",
                class: ["input", ("field-error-input" if @app.errors[:app_store_url].any?)].compact.join(" ") %>
          <p class="form-hint">Optional. Paste the full App Store listing URL.</p>
          <% if @app.errors[:app_store_url].any? %>
            <p class="field-error-message"><%= @app.errors[:app_store_url].first %></p>
          <% end %>
        </div>

        <div class="form-field">
          <%= label_tag "app_play_store_url", "Play Store URL", class: "form-label" %>
          <%= text_field_tag "app[play_store_url]",
                params.dig(:app, :play_store_url),
                placeholder: "https://play.google.com/store/apps/details?id=com.example.app",
                class: ["input", ("field-error-input" if @app.errors[:play_store_url].any?)].compact.join(" ") %>
          <p class="form-hint">Optional. Paste the full Google Play listing URL.</p>
          <% if @app.errors[:play_store_url].any? %>
            <p class="field-error-message"><%= @app.errors[:play_store_url].first %></p>
          <% end %>
        </div>

        <div class="form-actions">
          <%= link_to "Cancel", workspace_path(@workspace), class: "btn-secondary" %>
          <%= f.submit "ADD APP", class: "btn-primary" %>
        </div>

      <% end %>
    </div>
  </div>
</main>
