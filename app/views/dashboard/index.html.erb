<% content_for :title, "Dashboard — Reviews Analytics" %>

<main class="page-container">
  <header class="page-header" style="display: flex; align-items: center; justify-content: space-between;">
    <h1 class="page-title">Dashboard</h1>

    <div style="display: flex; align-items: center; gap: var(--space-4);">
      <%= link_to "CREATE WORKSPACE", new_workspace_path, class: "btn-secondary" %>
      <%= link_to "Sign out", sign_out_path, data: { turbo_method: :delete }, class: "btn-ghost" %>
    </div>
  </header>

  <div class="page-body">
    <div class="card" style="margin-bottom: var(--space-6);">
      <h2 class="card-title">Welcome back</h2>
      <p style="font-family: var(--font-body); color: var(--text-secondary); margin-bottom: var(--space-2);">
        <%= current_user.name %>
      </p>
      <p style="font-family: var(--font-mono); font-size: var(--text-sm); color: var(--text-tertiary);">
        <%= current_user.email %>
      </p>
    </div>

    <% if @workspaces.empty? %>
      <div class="card" style="text-align: center; padding: var(--space-16) var(--space-6);">
        <p style="
          font-family: var(--font-body);
          font-size: var(--text-lg);
          color: var(--text-secondary);
          margin-bottom: var(--space-8);
        ">
          You don't have any workspaces yet
        </p>
        <%= link_to "CREATE YOUR FIRST WORKSPACE", new_workspace_path, class: "btn-primary" %>
      </div>
    <% else %>
      <div>
        <h2 style="
          font-family: var(--font-body);
          font-size: var(--text-xl);
          font-weight: 600;
          color: var(--text-primary);
          margin-bottom: var(--space-4);
        ">
          Your Workspaces
        </h2>

        <ul style="list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--space-3);">
          <% @workspaces.each do |workspace| %>
            <% membership = workspace.workspace_memberships.find { |m| m.user_id == current_user.id } %>
            <li>
              <%= link_to workspace_path(workspace), style: "text-decoration: none;" do %>
                <div class="card card-interactive" style="
                  display: flex;
                  align-items: center;
                  justify-content: space-between;
                  cursor: pointer;
                ">
                  <div>
                    <span style="
                      font-family: var(--font-body);
                      font-size: var(--text-base);
                      font-weight: 600;
                      color: var(--text-primary);
                    ">
                      <%= workspace.name %>
                    </span>
                    <span style="
                      display: block;
                      font-family: var(--font-mono);
                      font-size: var(--text-xs);
                      color: var(--text-tertiary);
                      margin-top: var(--space-1);
                    ">
                      <%= "#{workspace.workspace_memberships.size} #{workspace.workspace_memberships.size == 1 ? 'member' : 'members'}" %>
                    </span>
                  </div>

                  <% if membership %>
                    <span style="
                      font-family: var(--font-mono);
                      font-size: var(--text-xs);
                      font-weight: 500;
                      text-transform: uppercase;
                      letter-spacing: var(--tracking-wider);
                      background: var(--bg-elevated);
                      border: 1px solid var(--border-default);
                      border-radius: var(--radius-sm);
                      padding: var(--space-1) var(--space-2);
                      color: var(--text-secondary);
                    ">
                      <%= membership.role %>
                    </span>
                  <% end %>
                </div>
              <% end %>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>
  </div>
</main>
