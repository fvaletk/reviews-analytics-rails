<% content_for :title, "Report History — #{@app.name} — #{@workspace.name} — Reviews Analytics" %>

<main class="page-container">
  <header class="page-header">
    <div class="flex items-center">
      <%= link_to "← #{@app.name}", workspace_app_path(@workspace, @app), class: "app-show-back-link" %>
    </div>
    <h1 class="page-title app-show-title">Report History</h1>
  </header>

  <div class="page-body">
    <div class="card report-history-card">
      <% if @reports.any? %>
        <ul class="report-history-list">
          <% @reports.each do |report| %>
            <li class="report-history-item">
              <div class="report-history-item-main">
                <%= link_to workspace_app_report_path(@workspace, @app, report), class: "report-history-date-link" do %>
                  <%= report.created_at.strftime("%B %-d, %Y at %-l:%M%P") %>
                <% end %>
                <span class="report-history-meta">
                  Generated by <%= report.generated_by.name.presence || report.generated_by.email %>
                </span>
              </div>

              <div class="report-history-item-stats">
                <span class="report-history-stat">
                  <%= report.total_reviews_analyzed %> reviews analyzed
                </span>
                <span class="report-history-stat">
                  App Store: <%= report.app_store_reviews_count %> / Play Store: <%= report.play_store_reviews_count %>
                </span>
              </div>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="report-history-empty">No reports yet.</p>
      <% end %>
    </div>
  </div>
</main>
