<% content_for :title, "#{@workspace.name} — Reviews Analytics" %>

<main class="page-container">
  <header class="page-header">
    <div class="flex" style="align-items: center; justify-content: space-between;">
      <h1 class="page-title"><%= @workspace.name %></h1>
      <% if policy(@workspace).invite? %>
        <%= link_to "INVITE MEMBER",
              new_workspace_membership_path(@workspace),
              class: "btn-primary" %>
      <% end %>
    </div>
  </header>

  <div class="page-body">
    <div class="card">
      <h2 class="card-title">Members</h2>

      <% members = @workspace.workspace_memberships.includes(:user).order(:role) %>
      <% if members.any? %>
        <ul style="list-style: none; margin: 0; padding: 0;">
          <% members.each do |m| %>
            <li style="
              display: flex;
              align-items: center;
              justify-content: space-between;
              padding: var(--space-3) 0;
              border-bottom: 1px solid var(--border-subtle);
            ">
              <div>
                <span style="
                  font-family: var(--font-body);
                  font-size: var(--text-sm);
                  color: var(--text-primary);
                  font-weight: 500;
                ">
                  <%= m.user.name.presence || m.user.email %>
                </span>
                <span style="
                  display: block;
                  font-family: var(--font-mono);
                  font-size: var(--text-xs);
                  color: var(--text-muted);
                ">
                  <%= m.user.email %>
                </span>
              </div>
              <span style="
                font-family: var(--font-mono);
                font-size: var(--text-xs);
                color: var(--text-secondary);
                text-transform: uppercase;
                letter-spacing: var(--tracking-wider);
              ">
                <%= m.role %>
              </span>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p style="
          font-family: var(--font-body);
          font-size: var(--text-sm);
          color: var(--text-muted);
        ">No members yet.</p>
      <% end %>
    </div>
  </div>
</main>
