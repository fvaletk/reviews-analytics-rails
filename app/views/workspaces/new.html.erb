<% content_for :title, "New Workspace — Reviews Analytics" %>

<main class="page-container">
  <header class="page-header">
    <h1 class="page-title">Create a Workspace</h1>
  </header>

  <div class="page-body">
    <div class="card" style="max-width: 480px;">
      <% if @workspace.errors.any? %>
        <div style="
          background: var(--critical-dim);
          border: 1px solid var(--critical);
          border-radius: var(--radius-md);
          padding: var(--space-3) var(--space-4);
          margin-bottom: var(--space-6);
        ">
          <ul style="
            list-style: none;
            margin: 0;
            padding: 0;
            font-family: var(--font-body);
            font-size: var(--text-sm);
            color: var(--critical);
          ">
            <% @workspace.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= form_with model: @workspace, url: workspaces_path, method: :post do |f| %>
        <div style="margin-bottom: var(--space-6);">
          <%= f.label :name, "Workspace Name",
                style: "
                  display: block;
                  font-family: var(--font-body);
                  font-size: var(--text-sm);
                  font-weight: 600;
                  color: var(--text-secondary);
                  letter-spacing: var(--tracking-wider);
                  text-transform: uppercase;
                  margin-bottom: var(--space-2);
                " %>
          <%= f.text_field :name,
                placeholder: "e.g. Acme Corp",
                class: "input",
                autofocus: true %>
        </div>

        <div class="flex" style="justify-content: flex-end;">
          <%= f.submit "CREATE WORKSPACE", class: "btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>
</main>
