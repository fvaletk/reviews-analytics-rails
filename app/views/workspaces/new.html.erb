<% content_for :title, "New Workspace — Reviews Analytics" %>

<main class="page-container">
  <header class="page-header">
    <h1 class="page-title">Create a Workspace</h1>
  </header>

  <div class="new-workspace-body">
    <div class="card new-workspace-card">
      <% if @workspace.errors.any? %>
        <div class="form-error-banner">
          <ul>
            <% @workspace.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= form_with model: @workspace, url: workspaces_path, method: :post do |f| %>
        <div class="form-field">
          <%= f.label :name, "Workspace Name", class: "form-label" %>
          <%= f.text_field :name,
                placeholder: "e.g. Acme Corp, My Startup...",
                class: "input",
                autofocus: true %>
        </div>

        <div class="form-actions">
          <%= link_to "CANCEL", root_path, class: "btn-ghost" %>
          <%= f.submit "CREATE WORKSPACE", class: "btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>
</main>
