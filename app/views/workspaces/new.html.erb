<% content_for :title, "New Workspace — Reviews Analytics" %>

<main class="page-container">
  <header class="page-header">
    <h1 class="page-title">Create a Workspace</h1>
  </header>

  <div class="page-body">
    <div class="card">
      <% if @workspace.errors.any? %>
        <div class="form-error-banner">
          <ul>
            <% @workspace.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= form_with model: @workspace, url: workspaces_path, method: :post do |f| %>
        <div class="form-field">
          <%= f.label :name, "Workspace Name",
                class: "block text-sm font-medium leading-6 text-white" %>
          <div class="mt-2">
            <%= f.text_field :name,
                  placeholder: "e.g. Acme Corp, My Startup...",
                  class: "block w-full rounded-md border-0 py-2 px-3 bg-white/5 ring-1 ring-inset ring-white/10 text-white placeholder:text-gray-500 focus:ring-2 focus:ring-inset focus:ring-amber-500 sm:text-sm sm:leading-6",
                  autofocus: true %>
          </div>
        </div>

        <div class="form-actions">
          <%= f.submit "CREATE WORKSPACE", class: "btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>
</main>
