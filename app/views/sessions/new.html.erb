<% content_for :title, "Sign In — Reviewly" %>

<div class="auth-container">
  <div class="auth-card">
    <h1 class="auth-title">Reviewly</h1>
    <p class="auth-subtitle">Competitive intelligence from your app store reviews</p>

    <%= button_to user_google_oauth2_omniauth_authorize_path,
          method: :post,
          data: { turbo: false },
          class: "btn-primary" do %>
      <span class="btn-google-content">
        <img src="https://www.svgrepo.com/show/475656/google-color.svg"
             alt="Google"
             class="btn-google-icon">
        Sign in with Google
      </span>
    <% end %>
  </div>
</div>
